; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kue Untuk Siapa"
run/main_scene="uid://oiirtrwhnmy0"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventManager="*res://scripts/autoload/event_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
SceneTransition="*res://scripts/autoload/scene_transition.gd"

[dialogic]

directories/dch_directory={
"bimo": "res://dialog/characters/bimo.dch",
"chia": "res://dialog/characters/chia.dch",
"mysterious_voice": "res://dialog/characters/mysterious_voice.dch",
"narator": "res://dialog/characters/narator.dch",
"orang yang tidak dikenal": "res://dialog/characters/orang yang tidak dikenal.dch"
}
directories/dtl_directory={
"birthdate_question": "res://dialog/timelines/birthdate_question.dtl",
"ending": "res://dialog/timelines/ending.dtl",
"finished_mysterious_door": "res://dialog/timelines/finished_mysterious_door.dtl",
"first_mysterious_door": "res://dialog/timelines/first_mysterious_door.dtl",
"hyacinth_question": "res://dialog/timelines/hyacinth_question.dtl",
"intj_question": "res://dialog/timelines/intj_question.dtl",
"mysterious_door": "res://dialog/timelines/mysterious_door.dtl",
"prologue": "res://dialog/timelines/prologue.dtl",
"red_question": "res://dialog/timelines/red_question.dtl",
"spawn_beemo": "res://dialog/timelines/spawn_beemo.dtl",
"spawn_beemoo": "res://dialog/timelines/spawn_beemoo.dtl",
"wrong_way": "res://dialog/timelines/wrong_way.dtl"
}
layout/style_directory={
"": "res://dialog/style/speaker.tres",
"speaker": "res://dialog/style/speaker.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://dialog/style/speaker.tres"]
layout/default_style="res://dialog/style/speaker.tres"
variables={
"player_name": "Chia"
}
text/letter_speed=0.05
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.0
animations/join_default_wait=true
animations/leave_default_length=0.0
animations/leave_default_wait=true
animations/cross_fade_default_length=0.0
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
animations/join_default="Fade In Up"
animations/leave_default="Fade Out Down"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom_font="uid://bm0hfco5u6de8"

